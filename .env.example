# Porta do Servidor Web
PORT=3000

# Credenciais da Meta WhatsApp Cloud API
# Obtenha em: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_API_VERSION=v21.0

# Token de Verificação do Webhook (crie uma senha segura qualquer para validar no painel do Meta)
META_VERIFY_TOKEN=meu_token_secreto_webhook_123

# Modo de Simulação / Sandbox (true para testar sem enviar de verdade, false para envio real oficial)
SIMULATION_MODE=true
